        h('div',{class:'prov'}, icon('check',13), h('span',{}, 'Gravado durante o atendimento · 16.06.2026 14h00 · trilha auditável'))
      );
      stepsWrap.style.display = 'none'; foot.style.display = 'none';
    });
    c.appendChild(h('div',{style:{marginTop:'14px'}}, audioBtn));
    return c;
  }
  function layerL4(){
    const logItem = function(when, actHtml, fin){
      return h('div',{class:'log-item'}, h('span',{class:'when'}, when),
        h('div',{class:'act'}, actHtml, h('span',{class:'fin'}, 'finalidade: '+fin)));
    };
    return h('div',{},
      h('div',{class:'t-sec', style:{marginBottom:'12px'}}, 'A transcrição (L3) mais o registro de tudo que foi alterado, por quem, quando e com que finalidade.'),
      logItem('16.06 · 14h32', h('span',{}, h('b',{}, 'Síntese gerada pelo ·Prumo'), ' a partir da gravação'), 'registro de atendimento'),
      logItem('16.06 · 14h45', h('span',{}, h('b',{}, 'Renata Souza'), ' ajustou o combinado “Nova conversa” (data → 02/07)'), 'precisão do acordo'),
      logItem('16.06 · 14h47', h('span',{}, h('b',{}, 'Renata Souza'), ' confirmou e registrou a síntese'), 'acompanhamento do caso'),
      logItem('16.06 · 14h47', h('span',{}, h('b',{}, 'Combinados distribuídos'), ' · família, Profa. Ana, combinado interno'), 'orquestração'));
  }

  function renderLayer(n){
    cur = n;
    stepsWrap.style.display = ''; foot.style.display = '';
    stepsWrap.querySelectorAll('.step').forEach(function(s){ s.classList.toggle('on', +s.dataset.layer===n); });
    const map = {1:layerL1, 2:layerL2, 3:layerL3, 4:layerL4};
    content.replaceChildren(map[n]());
    prevBtn.disabled = n<=1; nextBtn.disabled = n>=4;
    prevBtn.style.opacity = n<=1 ? '.4' : '1';
    nextBtn.style.opacity = n>=4 ? '.4' : '1';
  }

  STEPS.forEach(function(s){
    const step = h('div',{class:'step', dataset:{layer:''+s[0]}, role:'button', tabindex:'0', 'data-kbd':true}, s[1], h('small',{}, s[2]));
    step.addEventListener('click', function(){ renderLayer(s[0]); });
    stepsWrap.appendChild(step);
  });

  const prevBtn = h('button',{class:'btn-text'}, '← Camada anterior');
  const nextBtn = h('button',{class:'btn-text'}, 'Aprofundar →');
  prevBtn.addEventListener('click', function(){ if(cur>1) renderLayer(cur-1); });
  nextBtn.addEventListener('click', function(){ if(cur<4) renderLayer(cur+1); });
  const foot = h('div',{class:'layers-foot'}, prevBtn, nextBtn);

  holder.append(
    h('div',{class:'eyebrow ol'}, 'CAMADAS DA SÍNTESE'),
    h('h3',{class:'t-name', style:{margin:'8px 0 2px'}}, 'Atendimento com Fernanda · 16/06'),
    stepsWrap, content, foot
  );
  renderLayer(cur);
  openOverlay(holder,'drawer');
}
