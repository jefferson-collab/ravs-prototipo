const NAV_DEFS = {
  mesa:{label:'Mesa', icon:'home'},
  dashboard:{label:'Dashboard', icon:'eye'},
  acompanhamentos:{label:'Acompanhamentos', icon:'heart', badge:10},
  alunos:{label:'Alunos', icon:'users'},
  protocolos:{label:'Protocolos', icon:'repeat'},
  combinados:{label:'Combinados', icon:'target'}
};
const S = { view:'mesa', persona:'renata' };
function switchPersona(key){
  S.persona = key;
  if(PERSONAS[key].surface==='professor'){ renderProfessor(); return; }
  S.view = PERSONAS[key].home;
  renderShell();
  go(PERSONAS[key].home);
}

/* ===== professor (Parte 13.4) · sem shell ===== */
function viewProfessor(){
  const prof = h('div',{class:'prof'});

  const wm = h('span',{class:'wm', style:{cursor:'pointer'}, title:'Voltar ao app (protótipo)'}, h('span',{class:'dot'}, '·'), 'Prumo');
  wm.addEventListener('click', function(){ switchPersona('renata'); });
  prof.appendChild(h('div',{class:'prof-top'}, wm, h('span',{class:'t-meta'}, 'para professores')));

  const req = h('div',{class:'prof-req'});
  const simNao = h('div',{style:{display:'flex', gap:'8px', marginBottom:'16px'}});
  ['Sim','Não'].forEach(function(t){
    const p = h('span',{class:'pill neutral', style:{cursor:'pointer'}}, t);
    p.addEventListener('click', function(){
      simNao.querySelectorAll('.pill').forEach(function(x){ x.classList.remove('ol'); x.classList.add('neutral'); });
      p.classList.remove('neutral'); p.classList.add('ol');
    });
    simNao.appendChild(p);
  });
  const lk = h('div',{class:'likert', style:{marginBottom:'18px'}});
  [1,2,3,4,5].forEach(function(n){
    const pt = h('span',{class:'pt'+(n===3?' on':''), role:'button', tabindex:'0'}, ''+n);
    pt.addEventListener('click', function(){ lk.querySelectorAll('.pt').forEach(function(x){ x.classList.remove('on'); }); pt.classList.add('on'); });
    pt.addEventListener('keydown', function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); pt.click(); } });
    lk.appendChild(pt);
  });
  const enviar = Btn('Enviar observação','btn-primary');
  enviar.style.width='100%'; enviar.style.justifyContent='center';
  enviar.addEventListener('click', function(){
    req.replaceChildren(
      h('div',{class:'row', style:{gap:'12px', alignItems:'flex-start'}},
        h('span',{style:{width:'40px', height:'40px', borderRadius:'50%', background:'var(--olive-soft)', color:'var(--olive)', display:'flex', alignItems:'center', justifyContent:'center', flex:'none'}}, icon('check',20)),
        h('div',{}, h('div',{class:'t-strong'}, 'Observação enviada. Obrigada.'),
          h('div',{class:'t-meta', style:{marginTop:'3px'}}, 'Indexada ao Theo, ao caso e à dimensão automaticamente.')))
    );
  });
  req.append(
    h('div',{class:'eyebrow ol', style:{marginBottom:'8px'}}, 'A COORDENAÇÃO PEDIU UMA OBSERVAÇÃO'),
    h('p',{class:'t-body', style:{margin:'0 0 4px'}}, h('b',{}, 'Profa. Ana'), ', sobre o ', h('b',{}, 'Theo (4º A)'), ':'),
    h('h2',{class:'t-name', style:{fontSize:'19px', margin:'6px 0 14px'}}, 'Ficou sentado durante a rodinha hoje?'),
    simNao,
    h('div',{class:'t-sec', style:{marginBottom:'7px'}}, 'Estado ao fim da rodinha'),
    lk,
    likertAnchors(),
    enviar,
    h('p',{class:'t-meta', style:{textAlign:'center', margin:'12px 0 0'}}, 'Leva 30 segundos. Você não precisa instalar nada.')
  );
  prof.appendChild(req);

  prof.appendChild(h('div',{class:'section-lab'}, 'Seus documentos prontos'));
  prof.appendChild(h('p',{class:'t-sec', style:{margin:'0 0 12px'}}, 'Gerados a partir do que você já registrou: trabalho pronto, não trabalho a mais.'));
  const doc = function(dt, ds){
    return h('div',{class:'doc', style:{cursor:'pointer'}}, icon('file',20),
      h('div',{style:{flex:'1'}}, h('div',{class:'dt'}, dt), h('div',{class:'ds'}, ds)),
      icon('chevron-right',18));
  };
  prof.appendChild(doc('Portfólio do 2º bimestre · 1º A','pronto para revisar e enviar às famílias'));
  prof.appendChild(doc('Material de conselho de classe','organizado por aluno e dimensão'));

  return prof;
}
function renderProfessor(){
  const fab = h('button',{class:'fab', style:{display:'flex'}, 'aria-label':'Gravar'}, icon('mic',24));
  fab.addEventListener('click', openGravacaoMobile);
  const scroller = h('div',{style:{width:'100%', height:'100%', overflow:'auto', background:'var(--off-white)'}}, viewProfessor());
  document.getElementById('app').replaceChildren(scroller, fab);
}

function renderShell(){
  const persona = PERSONAS[S.persona] || PERSONAS.renata;
  const navItems = persona.nav.map(function(id){
    const def = NAV_DEFS[id];
    const kids = [icon(def.icon,18), h('span',{}, def.label)];
    if(def.badge) kids.push(h('span',{class:'badge'}, ''+def.badge));
    const a = h('a',{class:'sb-item'+(id===S.view?' on':''), role:'button', tabindex:'0', dataset:{view:id}}, kids);
    function activate(){
      go(id);
      const sb = document.querySelector('.sidebar.open'); if(sb) sb.classList.remove('open');
      const sc = document.querySelector('.scrim.open'); if(sc) sc.classList.remove('open');
    }
    a.addEventListener('click', activate);
    a.addEventListener('keydown', function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); activate(); } });
    return a;
  });

  const chev = icon('chevron-right',16); chev.style.transform='rotate(-90deg)'; chev.style.flex='none';
  const roleItems = ['renata','andre','marcos','professor'].map(function(key){
    const p = PERSONAS[key];
    const it = h('button',{class:'role-item'+(key===S.persona?' on':'')},
      h('span',{class:'av sm'}, p.mono),
      h('div',{style:{flex:'1', textAlign:'left'}},
        h('div',{class:'nm', style:{color:'var(--charcoal)'}}, p.nome),
        h('div',{class:'rl', style:{color:'var(--muted)'}}, p.papel)));
    it.addEventListener('click', function(e){ e.stopPropagation(); switchPersona(key); });
    return it;
  });
  const roleMenu = h('div',{class:'role-menu'}, roleItems);
  const foot = h('button',{class:'sb-foot', id:'role-switch', 'aria-haspopup':'true'},
    h('span',{class:'av'}, persona.mono),
    h('div',{style:{flex:'1', textAlign:'left'}}, h('div',{class:'nm'}, persona.nome), h('div',{class:'rl'}, persona.papel)),
    chev
  );
  foot.addEventListener('click', function(e){ e.stopPropagation(); roleMenu.classList.toggle('open'); });

  const sidebar = h('aside',{class:'sidebar'},
    h('div',{class:'sb-brand'}, h('span',{class:'dot'}, '·'), 'Prumo'),
    h('div',{class:'sb-brand-sub'}, 'ESCOLAS'),
    h('nav',{class:'sb-nav', 'aria-label':'Navegação principal'}, navItems),
    roleMenu,
    foot
  );

  const scrim = h('div',{class:'scrim'});
  const menuBtn = h('button',{class:'menu-btn', 'aria-label':'Abrir menu'}, icon('menu',22));
  menuBtn.addEventListener('click', function(e){ e.stopPropagation(); sidebar.classList.add('open'); scrim.classList.add('open'); });
  scrim.addEventListener('click', function(){ sidebar.classList.remove('open'); scrim.classList.remove('open'); });

  const fab = h('button',{class:'fab', 'aria-label':'Gravar'}, icon('mic',24));
  fab.addEventListener('click', function(){ go('gravacao'); });

  const main = h('div',{class:'main'},
    h('header',{class:'topbar'},
      h('div',{class:'row', style:{gap:'10px', minWidth:'0'}},
        menuBtn,
        h('div',{class:'crumb', id:'crumb', html:'Escolas / <b>Mesa</b>'})),
      h('div',{class:'tb-right'},
        h('div',{class:'tb-search'}, icon('search',16), 'Buscar aluno, família, combinado…'),
        GravarButton()
      )
    ),
    h('main',{class:'content', id:'conteudo'})
  );

  const app = document.getElementById('app');
  app.replaceChildren(sidebar, main, scrim, fab);
}

function go(view, params){
  clearInterval(_gravTimer);
  document.querySelectorAll('.overlay').forEach(function(el){ el.remove(); });
  S.view = view;
  S.params = params || {};
  // nav active state
  const active = NAV_ACTIVE[view] || view;
  document.querySelectorAll('.sb-item').forEach(function(el){
    el.classList.toggle('on', el.dataset.view===active);
  });
  // crumb
  const crumb = document.getElementById('crumb');
  crumb.innerHTML = CRUMBS[view] || ('Escolas / <b>'+(DATA.crumbs[view]||'')+'</b>');
  if(view==='perfil'){
    const a = (S.params && S.params.aluno) || THEO;
    crumb.innerHTML = 'Escolas / Alunos / <b>'+a.nome+'</b>';
  }
  if(view==='protocolo'){
    const p = (S.params && S.params.proto) || PROTOCOLOS[0];
    crumb.innerHTML = 'Escolas / Protocolos / <b>'+p.nome+'</b>';
  }
  if(view==='mesa' && S.persona==='andre'){
    crumb.innerHTML = 'Escolas / <b>Mesa da Direção</b>';
  }
  // content
  const content = document.getElementById('conteudo');
  content.replaceChildren((VIEWS[view]||viewSoon)());
  content.scrollTop = 0;
}

document.addEventListener('click', function(){
  const m = document.querySelector('.role-menu.open');
  if(m) m.classList.remove('open');
});
document.addEventListener('keydown', function(e){
  if(e.key!=='Enter' && e.key!==' ') return;
  const t = e.target;
  if(t && t.hasAttribute && t.hasAttribute('data-kbd')){ e.preventDefault(); t.click(); }
});
renderShell();
go('mesa');
</script>
</body>
</html>
