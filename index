    audioBtn.addEventListener('click', function(){
      const back = h('button',{class:'caso-back', style:{marginBottom:'14px'}}, icon('arrow-left',16), 'Voltar à transcrição');
      back.addEventListener('click', function(){ renderLayer(3); });
      content.replaceChildren(
        back,
        h('div',{class:'cap-player'}, icon('mic',20), h('span',{class:'t-strong'}, '00:00'),
          h('span',{class:'t-meta', style:{marginLeft:'auto'}}, 'duração 06:48')),
