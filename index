/* ===== registro de origem · log universal (Parte 17) ===== */
function openRegistro(opts){
  opts = opts || {};
  const kids = [
    h('div',{class:'eyebrow'}, opts.eyebrow || 'REGISTRO DE ORIGEM'),
    h('h3',{class:'t-name', style:{margin:'8px 0 4px'}}, opts.title || ''),
    opts.sub ? h('div',{class:'t-sec', style:{marginBottom:'14px'}}, opts.sub) : h('div',{style:{height:'10px'}})
  ];
  if(opts.body){
    if(Array.isArray(opts.body)) kids.push.apply(kids, opts.body);
    else if(typeof opts.body === 'string') kids.push(h('p',{class:'t-prose', style:{color:'var(--text-body)', marginBottom:'12px'}}, opts.body));
    else kids.push(opts.body);
  }
  if(opts.extra) kids.push(opts.extra);
  const parts = [opts.fonte || 'Registro'];
  if(opts.autor) parts.push(opts.autor);
  if(opts.data) parts.push(opts.data);
  parts.push('finalidade: '+(opts.finalidade || 'acompanhamento'));
  parts.push('trilha auditável');
  kids.push(h('div',{class:'prov'}, icon('check',13), h('span',{}, 'Fonte: '+parts.join(' · '))));
  openOverlay(h('div',{}, kids), 'drawer');
}

