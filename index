      const tr = h('tr',{},
        h('td',{}, h('div',{class:'ct'}, c.ct)),
        h('td',{}, h('div',{}, c.aluno), h('div',{class:'sub'}, c.caso)),
        h('td',{}, c.resp),
        h('td',{}, c.prazo),
        h('td',{}, cmbStatusCell(c)));
      if(c.go){ tr.setAttribute('role','button'); tr.setAttribute('tabindex','0'); tr.setAttribute('data-kbd',''); tr.addEventListener('click', function(){ go(c.go); }); }
      else { tr.style.cursor='default'; }
      tbody.appendChild(tr);
    });
  }

  CMB_FILTERS.forEach(function(f){
    const chip = h('span',{class:'pill neutral'+(f[0]===active?' on':''), role:'button', tabindex:'0', 'data-kbd':true}, f[0]);
    chip.addEventListener('click', function(){
      active = f[0];
      chipsWrap.querySelectorAll('.pill').forEach(function(x){ x.classList.remove('on'); });
      chip.classList.add('on');
      renderRows();
    });
    chipsWrap.appendChild(chip);
  });
  wrap.appendChild(chipsWrap);
