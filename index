/* modal / drawer (1.7.15) */
let _lastTrigger = null;
function openOverlay(node, kind){
  _lastTrigger = document.activeElement;
  const main = document.querySelector('.main') || document.getElementById('app');
  const overlay = h('div',{class:'overlay'});
  const x = h('button',{class:'modal-x','aria-label':'Fechar'}, icon('x',18));
  function close(){
    overlay.remove();
    document.removeEventListener('keydown', onKey);
    if(_lastTrigger && _lastTrigger.focus) _lastTrigger.focus();
  }
  function onKey(e){ if(e.key==='Escape') close(); }
  document.addEventListener('keydown', onKey);
  x.addEventListener('click', close);

  let panel;
  if(kind==='drawer'){
    panel = h('div',{class:'drawer'}, x, node);
    overlay.style.background = 'rgba(28,28,30,.22)';
    overlay.style.justifyContent = 'flex-end';
    overlay.style.alignItems = 'stretch';
  } else {
    panel = h('div',{class:'modal'}, x, node);
  }
  overlay.addEventListener('click', function(e){ if(e.target===overlay) close(); });
  overlay.appendChild(panel);
  main.appendChild(overlay);
  const focusable = panel.querySelector('button, [tabindex], textarea, a');
  if(focusable) focusable.focus();
  return { close: close, panel: panel };
}

function toast(text){
  const main = document.querySelector('.main') || document.getElementById('app');
  const t = h('div',{class:'toast'}, icon('check',16), text);
  main.appendChild(t);
  setTimeout(function(){ t.remove(); }, 3200);
}

