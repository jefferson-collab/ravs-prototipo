  wrap.appendChild(h('p',{class:'t-sec', style:{maxWidth:'640px'}}, 'O que foi combinado, com quem e até quando. O status se atualiza sozinho.'));

  let active = 'Todos';
  const chipsWrap = h('div',{class:'chips-filter'});
  const tbody = h('tbody');

  function renderRows(){
    const fn = (CMB_FILTERS.find(function(f){ return f[0]===active; }) || CMB_FILTERS[0])[1];
    const matched = COMBINADOS.filter(fn);
    tbody.replaceChildren();
    if(matched.length===0){
      const msg = active==='Aguardando resposta' ? 'Nenhum combinado aguardando resposta agora.' : 'Nenhum combinado neste filtro.';
      tbody.appendChild(h('tr',{}, h('td',{colspan:'5', style:{padding:'0'}},
