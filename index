<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>·Prumo Escolas · Farol</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ===== 1.2 · tokens ===== */
:root{
  --off-white:#F9F6F1; --charcoal:#1C1C1E; --charcoal-soft:#2C2C2E;
  --terracotta:#C4724A; --terracotta-ink:#9E5734; --terracotta-light:#D98E6A; --terracotta-soft:#F5E4D8;
  --olive:#4A6741; --olive-light:#8FB07E; --olive-soft:#EDF1E9;
  --slate:#4A6480; --slate-soft:#E2E7EE;
  --text-body:#555555; --muted:#6E6A62; --muted-on-dark:#9A958C; --on-dark:#DDDDDD;
  --line-light:#E5E0D6; --line-dark:#2F2F32; --white:#FFFFFF;
  --font-display:"Fraunces",Georgia,"Times New Roman",serif;
  --font-body:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --sp-1:4px; --sp-2:8px; --sp-3:12px; --sp-4:16px; --sp-5:20px; --sp-6:24px; --sp-8:32px; --sp-10:40px;
  --r-card:14px; --r-btn:9px; --r-pill:999px;
  --shadow-soft:0 14px 36px -16px rgba(28,28,30,.30);
  --shadow-modal:0 20px 60px -20px rgba(28,28,30,.45);
  --focus:0 0 0 2px var(--off-white),0 0 0 4px var(--slate);
}

/* ===== 1.3 · base & reset ===== */
*{box-sizing:border-box}
html,body{margin:0;height:100%}
body{background:var(--off-white);color:var(--text-body);font-family:var(--font-body);font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
button{font-family:inherit;cursor:pointer;border:none;background:none}
a{color:inherit;text-decoration:none}
:focus-visible{outline:none;box-shadow:var(--focus)}
::selection{background:var(--terracotta-soft)}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0}
.skip{position:absolute;left:8px;top:-44px;background:var(--charcoal);color:#fff;padding:8px 14px;border-radius:8px;z-index:60;font-size:13px;font-weight:600;transition:top .16s}
.skip:focus{top:8px}
@media (prefers-reduced-motion: reduce){*{transition:none!important;animation:none!important}}

/* ===== 1.4 · type scale ===== */
.t-greet{font-family:var(--font-display);font-weight:600;font-size:28px;letter-spacing:-.01em;color:var(--charcoal);line-height:1.1;margin:0}
.t-name{font-family:var(--font-display);font-weight:600;font-size:22px;color:var(--charcoal);line-height:1.15;margin:0}
.t-card{font-family:var(--font-display);font-weight:600;font-size:18px;color:var(--charcoal);line-height:1.2;margin:0}
.t-prose{font-family:var(--font-display);font-weight:400;font-style:italic;font-size:17px;color:var(--charcoal);line-height:1.45;margin:0}
.t-body{font-size:15px;line-height:1.5;color:var(--text-body);margin:0}
.t-strong{font-size:15px;font-weight:600;color:var(--charcoal)}
.t-sec{font-size:13px;color:var(--muted);line-height:1.45;margin:0}
.t-label{font-size:11.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.t-meta{font-size:12px;color:var(--muted)}
.t-btn{font-size:14px;font-weight:600}

/* ===== 1.5 · shell ===== */
.app{display:flex;height:100vh;overflow:hidden}
.sidebar{width:240px;flex:none;background:var(--charcoal);color:var(--on-dark);display:flex;flex-direction:column;padding:22px 0}
.sb-brand{font-family:var(--font-display);font-size:23px;color:var(--off-white);padding:0 22px 2px}
.sb-brand .dot{color:var(--terracotta)}
.sb-brand-sub{font-size:10px;font-weight:700;letter-spacing:.32em;color:var(--muted-on-dark);padding:0 22px 20px}
.sb-nav{display:flex;flex-direction:column;gap:3px;padding:0 12px}
.sb-item{position:relative;display:flex;align-items:center;gap:12px;padding:11px 14px;border-radius:9px;color:var(--muted-on-dark);font-size:13.5px;font-weight:500;transition:background .16s,color .16s}
.sb-item svg{width:18px;height:18px;flex:none}
.sb-item .badge{margin-left:auto;font-size:11px;font-weight:700;background:var(--terracotta);color:#fff;border-radius:10px;padding:1px 8px}
.sb-item:hover{color:var(--off-white);background:rgba(255,255,255,.05)}
.sb-item.on{background:var(--olive-soft);color:var(--charcoal);font-weight:600}
.sb-item.on::before{content:"";position:absolute;left:0;top:8px;bottom:8px;width:3px;border-radius:3px;background:var(--terracotta)}
.sb-foot{margin-top:auto;display:flex;align-items:center;gap:11px;padding:16px 18px 0;margin:16px 14px 0;border-top:1px solid var(--line-dark)}
.sb-foot .av{width:36px;height:36px;flex:none;border-radius:50%;background:var(--olive);color:#fff;font-family:var(--font-display);font-weight:600;font-size:14px;display:flex;align-items:center;justify-content:center}
.sb-foot .nm{font-size:13.5px;color:var(--on-dark);font-weight:500}
.sb-foot .rl{font-size:11.5px;color:var(--muted-on-dark)}
.main{flex:1;display:flex;flex-direction:column;min-width:0;position:relative}
.topbar{height:56px;flex:none;background:var(--off-white);border-bottom:1px solid var(--line-light);display:flex;align-items:center;justify-content:space-between;padding:0 26px;gap:20px}
.crumb{font-size:13px;color:var(--muted)} .crumb b{color:var(--charcoal);font-weight:600}
.tb-right{display:flex;align-items:center;gap:14px}
.tb-search{display:flex;align-items:center;gap:9px;background:var(--white);border:1px solid var(--line-light);border-radius:9px;height:36px;padding:0 14px;width:300px;color:var(--muted);font-size:13px}
.tb-search svg{width:16px;height:16px;flex:none}
.content{flex:1;overflow:auto;padding:24px 32px 48px}
.content-narrow{max-width:1120px;margin:0 auto}

/* ===== 1.7.1 · buttons ===== */
.btn{display:inline-flex;align-items:center;gap:8px;border-radius:var(--r-btn);font-size:14px;font-weight:600;padding:10px 18px;transition:background .16s,border-color .16s}
.btn svg{width:16px;height:16px}
.btn-primary{background:var(--olive);color:#fff} .btn-primary:hover{background:#3d5636}
.btn-dark{background:var(--charcoal);color:var(--off-white)} .btn-dark:hover{background:var(--charcoal-soft)}
.btn-ghost{background:transparent;color:var(--charcoal);border:1px solid var(--line-light)} .btn-ghost:hover{background:rgba(0,0,0,.03)}
.btn-text{background:transparent;color:var(--terracotta-ink);padding:10px 6px} .btn-text:hover{text-decoration:underline}
.btn[disabled]{opacity:.45;cursor:not-allowed}

/* ===== 1.7.2 · eyebrow / section label ===== */
.eyebrow{font-size:11.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--terracotta-ink)}
.eyebrow.ol{color:var(--olive)} .eyebrow.sl{color:var(--slate)}
.section-lab{font-size:11.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:10px}

/* ===== 1.7.3 · card ===== */
.card{background:var(--white);border:1px solid var(--line-light);border-radius:var(--r-card);padding:18px 20px}
.card.quiet{background:var(--olive-soft);border-color:transparent}
.card.ctx{background:var(--terracotta-soft);border-color:var(--terracotta-light)}
.card.info{background:var(--slate-soft);border-color:transparent}
.card.dark{background:var(--charcoal);border:none;color:var(--on-dark)}
.card.dark .t-card{color:var(--off-white)}

/* ===== 1.7.4 · urgency hairline ===== */
.urg{border-left:5px solid var(--line-light);border-top-left-radius:0;border-bottom-left-radius:0}
.urg-agora{border-left-color:var(--terracotta)}
.urg-hoje{border-left-color:var(--slate)}
.urg-semana{border-left-color:var(--line-light)}
.urg-vencido{border-left-style:dashed;border-left-color:var(--terracotta-ink)}

/* ===== 1.7.5 · pill ===== */
.pill{display:inline-flex;align-items:center;gap:6px;border-radius:var(--r-pill);font-size:11.5px;font-weight:700;letter-spacing:.04em;padding:5px 12px;background:var(--terracotta-soft);color:var(--terracotta-ink);white-space:nowrap}
.pill svg{width:13px;height:13px}
.pill.ol{background:var(--olive-soft);color:var(--olive)}
.pill.sl{background:var(--slate-soft);color:var(--slate)}
.pill.neutral{background:var(--off-white);border:1px solid var(--line-light);color:var(--charcoal);font-weight:600}

/* ===== 1.7.6 · família-escola tag ===== */
.fam-tag{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--charcoal);background:var(--off-white);border:1px solid var(--line-light);border-radius:var(--r-pill);padding:4px 11px;white-space:nowrap;flex:none}
.fam-tag .dot{width:6px;height:6px;border-radius:50%;background:var(--muted)}

/* ===== 1.7.7 · avatar ===== */
.av{width:40px;height:40px;flex:none;border-radius:50%;background:var(--terracotta-soft);color:var(--terracotta-ink);font-family:var(--font-display);font-weight:600;font-size:15px;display:flex;align-items:center;justify-content:center}
.av.sm{width:30px;height:30px;font-size:12px}

/* ===== 1.7.8 · gravar / add ctx ===== */
.gravar{display:inline-flex;align-items:center;gap:9px;background:var(--terracotta);color:#fff;border-radius:var(--r-btn);font-size:14px;font-weight:600;padding:10px 18px}
.gravar:hover{background:var(--terracotta-ink)} .gravar .dot{width:8px;height:8px;border-radius:50%;background:#fff}
.add-ctx{display:inline-flex;gap:8px;flex-wrap:wrap}

/* ===== 1.7.9 · drill to source ===== */
.drill{display:inline-flex;align-items:center;gap:5px;font-size:12.5px;font-weight:600;color:var(--terracotta-ink);padding:4px 0}
.drill svg{width:13px;height:13px}
.drill:hover{text-decoration:underline}

/* ===== 1.7.10 · provenance ===== */
.prov{display:flex;align-items:center;gap:8px;font-size:11.5px;color:var(--muted);padding-top:8px;margin-top:10px;border-top:1px solid var(--line-light)}
.prov svg{width:13px;height:13px;color:var(--olive);flex:none}

/* ===== 1.7.11 · combinado row ===== */
.cmb{background:var(--white);border:1px solid var(--line-light);border-radius:11px;padding:12px 16px;margin-bottom:8px}
.cmb-t{font-size:14.5px;font-weight:600;color:var(--charcoal);line-height:1.3}
.cmb-m{font-size:12px;color:var(--muted);margin-top:3px}
.cmb-btns{display:flex;gap:7px;margin-top:9px;align-items:center}
.cmb-btns button{font-size:12.5px;font-weight:600;padding:6px 13px;border-radius:7px;border:1px solid transparent}
.cmb-acc{background:var(--olive);color:#fff}
.cmb-adj{background:var(--white);border-color:var(--line-light);color:var(--charcoal)}
.cmb-rem{background:transparent;color:var(--muted)}

/* ===== 1.7.12 · capture modalities ===== */
.cap-player{display:flex;align-items:center;gap:12px;background:var(--white);border:1px solid var(--line-light);border-radius:11px;padding:12px 16px}
.likert{display:flex;gap:8px}
.likert .pt{width:26px;height:26px;border-radius:50%;border:1.5px solid var(--line-light);display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--muted);cursor:pointer}
.likert .pt.on{border-color:var(--olive);background:var(--olive-soft);color:var(--olive);font-weight:700}
.cap-tabs{display:flex;gap:8px;margin-bottom:16px}
.cap-tab{font-size:12.5px;font-weight:600;color:var(--muted);background:var(--white);border:1px solid var(--line-light);border-radius:var(--r-pill);padding:6px 14px}
.cap-tab.on{background:var(--charcoal);color:var(--off-white);border-color:var(--charcoal)}
.rubric-chips{display:flex;gap:8px}
.chip{font-size:12.5px;font-weight:600;color:var(--charcoal);background:var(--white);border:1px solid var(--line-light);border-radius:var(--r-pill);padding:6px 16px}
.chip.on{background:var(--olive-soft);border-color:var(--olive);color:var(--olive)}
textarea{width:100%;font-family:var(--font-body);font-size:14px;color:var(--charcoal);background:var(--white);border:1px solid var(--line-light);border-radius:11px;padding:12px 14px;resize:vertical;min-height:90px}
textarea:focus-visible{outline:none;box-shadow:var(--focus)}

/* ===== 1.7.13 · index proposta ===== */
.idx{background:var(--olive-soft);border-radius:12px;padding:14px 16px}
.idx-h{font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--olive);margin-bottom:10px}
.idx-row{display:flex;justify-content:space-between;gap:12px;font-size:13px;padding:6px 0;border-bottom:1px solid rgba(74,103,65,.15)}
.idx-row b{color:var(--charcoal);font-weight:600}
.idx-edit{font-size:12px;color:var(--terracotta-ink);font-weight:600;flex:none}

/* ===== 1.7.14 · severity ===== */
.sev{display:inline-flex;align-items:center;gap:8px;font-size:12.5px;color:var(--charcoal);background:var(--off-white);border:1px solid var(--line-light);border-radius:9px;padding:6px 12px}
.sev b{font-weight:700}

/* ===== 1.7.15 · modal / drawer ===== */
.overlay{position:absolute;inset:0;background:rgba(28,28,30,.22);display:flex;align-items:center;justify-content:center;z-index:30}
.modal{width:min(720px,92%);max-height:86%;overflow:auto;background:var(--off-white);border:1px solid var(--line-light);border-radius:18px;box-shadow:var(--shadow-modal);padding:22px 26px}
.drawer{position:absolute;top:0;right:0;height:100%;width:min(520px,90%);background:var(--off-white);border-left:1px solid var(--line-light);box-shadow:var(--shadow-modal);overflow:auto;padding:22px 24px;z-index:30}
.modal-x{float:right;width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--muted)}
.modal-x:hover{background:rgba(0,0,0,.05)}

/* ===== 1.7.16 · states ===== */
.toast{position:absolute;left:50%;bottom:26px;transform:translateX(-50%);display:flex;align-items:center;gap:9px;background:var(--olive);color:#fff;padding:11px 18px;border-radius:10px;box-shadow:var(--shadow-soft);font-size:13.5px;font-weight:600;z-index:50}
.toast svg{width:16px;height:16px}
.empty{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:10px;padding:60px 20px;max-width:420px;margin:40px auto 0}
.empty .ic{width:46px;height:46px;border-radius:50%;background:var(--olive-soft);color:var(--olive);display:flex;align-items:center;justify-content:center}
.skel{background:var(--line-light);border-radius:8px;animation:pulse 1.4s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}

/* helpers */
.row{display:flex;align-items:center;gap:12px}
.col{display:flex;flex-direction:column}
.wrap{flex-wrap:wrap}
.between{justify-content:space-between}
.stat-row{display:flex;gap:32px}
.stat .n{font-family:var(--font-display);font-weight:600;font-size:30px;color:var(--charcoal);line-height:1}
.stat .l{font-size:12px;color:var(--muted);margin-top:4px}
.tl{position:relative;padding-left:20px}
.tl::before{content:"";position:absolute;left:3px;top:6px;bottom:6px;width:2px;background:var(--line-light)}
.tl-item{position:relative;padding:0 0 16px}
.tl-item::before{content:"";position:absolute;left:-20px;top:5px;width:8px;height:8px;border-radius:50%;background:var(--olive)}

/* ===== 3.2 · caso ===== */
.caso-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.caso-back{display:inline-flex;align-items:center;gap:7px;font-size:13px;color:var(--muted)}
.caso-back svg{width:16px;height:16px}
.caso-head{display:flex;align-items:flex-start;gap:14px;margin-bottom:10px}
.caso-head .t-name{font-size:24px}
.caso-meta{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.caso-section{margin-top:26px}
.resumo{background:var(--olive-soft);border-radius:var(--r-card);padding:16px 20px}
.rede{display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start}
.rede-col{background:var(--white);border:1px solid var(--line-light);border-radius:var(--r-card);padding:16px 18px}
.rel{display:flex;gap:10px;padding:9px 0;border-bottom:1px solid var(--line-light)}
.rel:last-child{border-bottom:none}
.rel .dot{width:8px;height:8px;border-radius:50%;margin-top:6px;flex:none}
.rel .role{font-size:12px;color:var(--muted)} .rel .who{font-family:var(--font-display);font-weight:600;font-size:15px;color:var(--charcoal)}
.atrito{display:flex;gap:12px;align-items:baseline;padding:9px 0;border-bottom:1px solid var(--line-light)}
.atrito:last-child{border-bottom:none}
.atrito .dot{width:8px;height:8px;border-radius:50%;background:var(--muted);flex:none;align-self:center}
.atrito .when{font-weight:600;color:var(--charcoal);font-size:14px;min-width:104px}
.dims{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.dim{background:var(--white);border:1px solid var(--line-light);border-radius:var(--r-card);padding:16px 18px;cursor:pointer;transition:border-color .16s}
.dim:hover{border-color:var(--slate-soft)}
.fontes{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.fonte{display:flex;align-items:center;gap:12px;background:var(--white);border:1px solid var(--line-light);border-radius:11px;padding:12px 16px;cursor:pointer;transition:border-color .16s}
.fonte:hover{border-color:var(--slate-soft)} .fonte>svg{width:18px;height:18px;color:var(--slate);flex:none}
.fonte .ttl{font-size:14px;font-weight:600;color:var(--charcoal)} .fonte .sub{font-size:12px;color:var(--muted)}
.tr-line{display:flex;gap:10px;padding:7px 0;font-size:14px;line-height:1.5}
.tr-line .ts{color:var(--muted);min-width:54px;font-size:12px;font-variant-numeric:tabular-nums}
.tr-line.inflex{background:var(--olive-soft);border-radius:8px;padding:9px 12px;margin:4px -12px}
.acmp-row{display:flex;align-items:center;gap:14px;background:var(--white);border:1px solid var(--line-light);border-radius:var(--r-card);padding:16px 18px;cursor:pointer;transition:border-color .16s;margin-bottom:10px}
.acmp-row:hover{border-color:var(--slate-soft)}

/* ===== 4.1 · preparação ===== */
.prep-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:20px;align-items:start}
.prep-col{display:flex;flex-direction:column;gap:14px}
.prep-rail{display:flex;flex-direction:column;gap:14px}
.pnum{list-style:none;margin:0;padding:0;counter-reset:p;display:flex;flex-direction:column;gap:11px}
.pnum li{position:relative;padding-left:34px;counter-increment:p;font-size:14.5px;line-height:1.45;color:var(--text-body)}
.pnum li::before{content:counter(p);position:absolute;left:0;top:0;width:22px;height:22px;border-radius:50%;background:var(--olive-soft);color:var(--olive);font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center}
.proto-vig{background:var(--olive-soft);border-radius:var(--r-card);padding:14px 18px}
.rail-links{display:flex;flex-direction:column;gap:7px;margin-top:12px}
.rail-links button{width:100%;text-align:left;display:flex;align-items:center;gap:9px;background:transparent;border:1px solid var(--line-dark);color:var(--on-dark);font-size:13px;padding:9px 14px;border-radius:9px}
.rail-links button:hover{background:rgba(255,255,255,.06)}
.rail-links button svg{width:15px;height:15px;flex:none}
@media (max-width:900px){.prep-grid{grid-template-columns:1fr}.prep-rail{order:-1}}

/* ===== 5.1 · atendimento ao vivo ===== */
.live-bar{display:flex;align-items:center;gap:18px;background:var(--charcoal);color:var(--off-white);border-radius:var(--r-card);padding:16px 22px}
.rec-dot{width:11px;height:11px;border-radius:50%;background:var(--terracotta);animation:pulse 1.8s ease-in-out infinite}
.rec-time{font-family:var(--font-display);font-size:24px;color:var(--off-white);font-variant-numeric:tabular-nums}
.rec-lab{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted-on-dark)}
.live-controls{margin-left:auto;display:flex;gap:9px}
.live-controls button{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);color:var(--on-dark);font-size:13px;font-weight:600;padding:9px 15px;border-radius:9px}
.live-controls button svg{width:15px;height:15px}
.live-controls button:hover{background:rgba(255,255,255,.14)}
.live-controls .end{background:var(--terracotta);border-color:transparent;color:#fff}
.live-controls .end:hover{background:var(--terracotta-ink)}
.live-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:18px;align-items:start}
.roteiro-live{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}
.roteiro-live li{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:var(--text-body)}
.roteiro-live .chk{width:20px;height:20px;flex:none;border-radius:6px;border:1.5px solid var(--line-light);display:flex;align-items:center;justify-content:center;cursor:pointer;margin-top:1px}
.roteiro-live .chk.on{background:var(--olive);border-color:var(--olive);color:#fff}
.roteiro-live .chk.on svg{width:13px;height:13px}
.capturing{background:var(--olive-soft);border-radius:var(--r-card);padding:14px 18px}
.live-now{display:flex;align-items:center;gap:8px;font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:var(--olive)}
.live-now .dot{width:8px;height:8px;border-radius:50%;background:var(--olive);animation:pulse 1.4s ease-in-out infinite}
@keyframes capIn{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}
.cap-in{animation:capIn .45s ease both}
.cap-feed{display:flex;flex-direction:column;gap:0}
.cap-feed .ts{font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--olive);flex:none;width:42px}
.cap-feed .cap-row{align-items:flex-start}
.cap-row{display:flex;justify-content:space-between;gap:12px;font-size:13px;padding:6px 0;border-bottom:1px solid rgba(74,103,65,.15)}
.cap-row:last-child{border-bottom:none} .cap-row b{color:var(--charcoal);font-weight:600}

/* ===== 6.1 · síntese viva ===== */
.syn-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:20px;align-items:start}
.syn-l1{background:linear-gradient(160deg,#EEF2E8,#E4ECDC);border:1px solid var(--olive-light);border-radius:var(--r-card);padding:20px 22px}
.syn-l1 p{font-family:var(--font-display);font-size:17px;color:var(--charcoal);line-height:1.5;margin:0 0 10px}
.syn-l1 p:last-of-type{margin-bottom:0}
.syn-envolvidos{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px;padding-top:12px;border-top:1px solid var(--olive-light)}
.syn-layers{display:flex;flex-direction:column;gap:2px;margin-top:14px}
.syn-layers .drill{padding:8px 0;border-bottom:1px solid var(--line-light)}
@media (max-width:900px){.live-grid,.syn-grid{grid-template-columns:1fr}}

/* ===== 6.4 · camadas + log ===== */
.layers-steps{display:flex;gap:6px;margin:12px 0 18px}
.layers-steps .step{flex:1;text-align:center;font-size:11.5px;font-weight:700;letter-spacing:.06em;padding:8px 4px;border-radius:8px;background:var(--off-white);border:1px solid var(--line-light);color:var(--muted);cursor:pointer}
.layers-steps .step.on{background:var(--olive-soft);border-color:var(--olive-light);color:var(--olive)}
.layers-steps .step small{display:block;font-weight:500;letter-spacing:0;text-transform:none;font-size:10px;margin-top:2px}
.tema{padding:13px 0;border-bottom:1px solid var(--line-light)} .tema:last-child{border-bottom:none}
.tema .h{font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--olive);margin-bottom:5px}
.tema .h.tc{color:var(--terracotta-ink)}
.tema p{margin:0;font-size:14px;line-height:1.5;color:var(--text-body)}
.tr-mark{font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--olive);background:var(--olive-soft);border-radius:5px;padding:2px 7px;margin-left:6px;white-space:nowrap}
.tr-mark.cmb{color:var(--terracotta-ink);background:var(--terracotta-soft)}
.log-item{display:flex;gap:12px;padding:11px 0;border-bottom:1px solid var(--line-light);font-size:13px}
.log-item:last-child{border-bottom:none}
.log-item .when{min-width:118px;color:var(--muted);font-variant-numeric:tabular-nums;flex:none}
.log-item .act b{color:var(--charcoal)} .log-item .fin{color:var(--muted);font-size:12px;display:block;margin-top:2px}
.layers-foot{display:flex;justify-content:space-between;align-items:center;margin-top:16px;padding-top:14px;border-top:1px solid var(--line-light)}

/* ===== 7.1 · loop ativo ===== */
.destino{display:flex;align-items:flex-start;gap:16px;background:var(--white);border:1px solid var(--line-light);border-radius:var(--r-card);padding:16px 20px;margin-bottom:12px}
.destino .arrow{color:var(--terracotta-ink);font-weight:700;flex:none;font-size:16px;line-height:1.4}
.destino .body{flex:1;min-width:0}
.destino .dlab{font-size:11.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.destino .dttl{font-family:var(--font-display);font-weight:600;font-size:16px;color:var(--charcoal);margin:3px 0 4px}
.destino .dmsg{font-size:13.5px;color:var(--text-body);line-height:1.45}
.destino .dright{display:flex;flex-direction:column;align-items:flex-end;gap:9px;flex:none}
.status{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;color:var(--muted);font-weight:600;white-space:nowrap}
.status .ind{width:10px;height:10px;border-radius:50%;flex:none;border:1.5px solid var(--muted)}
.status.aguardando .ind{background:transparent}
.status.enviado .ind,.status.lido .ind{background:var(--muted)}
.status.andamento .ind{background:linear-gradient(90deg,var(--muted) 50%,transparent 51%)}
.status.cumprido{color:var(--olive)} .status.cumprido .ind{background:var(--olive);border-color:var(--olive)}
.loop-foot{display:flex;align-items:center;gap:9px;margin-top:18px;padding-top:14px;border-top:1px solid var(--line-light);font-size:12.5px;color:var(--muted)}
.loop-foot svg{width:14px;height:14px;color:var(--olive);flex:none}
.dev-msg{width:100%;background:var(--white);border:1.5px solid var(--olive-light);border-radius:11px;padding:14px 16px;font-size:14px;line-height:1.55;color:var(--charcoal);font-family:var(--font-body)}
.dev-ask{background:var(--olive-soft);border-radius:10px;padding:11px 14px;margin-top:12px;font-size:13px;color:var(--charcoal)}
.dev-resp{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}

/* ===== 2.2 · mesa ===== */
.mesa-head{margin-bottom:18px}
.cats{display:flex;gap:30px;padding:6px 0 2px}
.cat{display:flex;flex-direction:column;gap:3px;cursor:pointer}
.cat .n{font-family:var(--font-display);font-weight:600;font-size:20px;color:var(--charcoal);line-height:1}
.cat .l{font-size:13px;color:var(--muted)}
.cat:hover .l{color:var(--charcoal)}
.mesa-section{margin-top:22px}
.mesa-card-actions{display:flex;align-items:center;gap:18px;margin-top:14px}
.capture-strip{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-top:30px;padding-top:20px;border-top:1px solid var(--line-light)}
.capture-strip .lab{font-size:13px;color:var(--muted)}

/* ===== 8.1 · alunos + perfil ===== */
.filters{display:flex;gap:14px;align-items:center;margin:14px 0 8px;flex-wrap:wrap}
.select{display:inline-flex;align-items:center;gap:10px;background:var(--white);border:1px solid var(--line-light);border-radius:9px;height:38px;padding:0 14px;font-size:13.5px;color:var(--charcoal);cursor:pointer}
.select:hover{border-color:var(--slate-soft)}
.select svg{width:14px;height:14px;color:var(--muted)}
.roster{width:100%;border-collapse:collapse;margin-top:10px}
.roster th{text-align:left;font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:0 0 10px;border-bottom:1px solid var(--line-light)}
.roster td{padding:12px 8px 12px 0;border-bottom:1px solid var(--line-light);font-size:14px;vertical-align:middle}
.roster tbody tr{cursor:pointer}
.roster tbody tr:hover td{background:rgba(0,0,0,.014)}
.roster .num{color:var(--muted);font-variant-numeric:tabular-nums;width:44px}
.roster .who{display:flex;align-items:center;gap:11px}
.roster .nm{font-family:var(--font-display);font-weight:600;font-size:15px;color:var(--charcoal)}
.roster .acc{font-size:13px;color:var(--muted)}
.roster .perfil{text-align:right;width:110px;color:var(--terracotta-ink);font-size:13px;font-weight:600}
.perfil-head{display:flex;gap:18px;align-items:center;margin-bottom:6px}
.perfil-photo{width:72px;height:72px;border-radius:16px;flex:none;background:var(--terracotta-soft);color:var(--terracotta-ink);font-family:var(--font-display);font-weight:600;font-size:26px;display:flex;align-items:center;justify-content:center}
.acc-item{display:flex;justify-content:space-between;align-items:center;gap:14px;background:var(--white);border:1px solid var(--line-light);border-radius:11px;padding:13px 16px;margin-bottom:8px;cursor:pointer}
.acc-item:hover{border-color:var(--slate-soft)}
.acc-item .meta{font-size:12.5px;color:var(--muted)}

/* ===== 9.1 · protocolos ===== */
.proto-meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px 28px;margin:14px 0 4px}
.proto-meta .k{font-size:12px;color:var(--muted)}
.proto-meta .v{font-size:14px;color:var(--charcoal);font-weight:600;margin-top:2px}
.cont{background:var(--white);border:1px solid var(--line-light);border-radius:11px;padding:13px 16px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:14px}
.cont .ct{font-size:14.5px;font-weight:600;color:var(--charcoal)}
.cont .cm{font-size:12.5px;color:var(--muted);margin-top:2px}
.rubrica{background:var(--olive-soft);border-radius:12px;padding:14px 16px}
.rubrica-item{padding:10px 0;border-bottom:1px solid rgba(74,103,65,.15)}
.rubrica-item:last-child{border-bottom:none}
.indic{display:flex;align-items:center;gap:14px;padding:9px 0;font-size:13.5px;color:var(--charcoal)}
.bar{height:8px;border-radius:4px;background:var(--line-light);width:200px;flex:none;overflow:hidden}
.bar i{display:block;height:100%;background:var(--olive);border-radius:4px}
.revisao{background:var(--terracotta-soft);border:1px solid var(--terracotta-light);border-radius:12px;padding:15px 18px}

/* ===== 10.1 · combinados ===== */
.chips-filter{display:flex;gap:8px;margin:14px 0 6px;flex-wrap:wrap}
.chips-filter .pill{cursor:pointer}
.chips-filter .pill.on{background:var(--charcoal);color:var(--off-white)}
.cmb-table{width:100%;border-collapse:collapse;margin-top:8px}
.cmb-table th{text-align:left;font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:0 12px 10px 0;border-bottom:1px solid var(--line-light)}
.cmb-table td{padding:13px 12px 13px 0;border-bottom:1px solid var(--line-light);font-size:14px;vertical-align:middle}
.cmb-table tbody tr{cursor:pointer}
.cmb-table tbody tr:hover td{background:rgba(0,0,0,.014)}
.cmb-table .ct{font-weight:600;color:var(--charcoal)}
.cmb-table .sub{font-size:12px;color:var(--muted);margin-top:2px}

/* ===== 11.1 · versões cruzadas + solicitar observação ===== */
.vc-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start}
.vc-col{background:var(--white);border:1px solid var(--line-light);border-radius:var(--r-card);padding:16px 18px}
.vc-who{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.vc-mod{font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.conv{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid var(--line-light);font-size:14px;line-height:1.45}
.conv:last-child{border-bottom:none}
.conv .tag{font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;border-radius:5px;padding:3px 8px;flex:none;height:fit-content;margin-top:2px}
.conv .tag.cv{color:var(--olive);background:var(--olive-soft)}
.conv .tag.dv{color:var(--slate);background:var(--slate-soft)}
.ponderar{background:var(--olive-soft);border-radius:12px;padding:14px 16px}
.so-field{margin-bottom:18px}
.so-field .lab{font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.so-input{width:100%;background:var(--white);border:1px solid var(--line-light);border-radius:10px;padding:11px 14px;font-size:14px;font-family:var(--font-body);color:var(--charcoal)}
.so-input:focus-visible{outline:none;box-shadow:var(--focus)}
.mod-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.mod-card{background:var(--white);border:1.5px solid var(--line-light);border-radius:12px;padding:14px 16px;cursor:pointer;transition:border-color .16s}
.mod-card.on{border-color:var(--olive);background:var(--olive-soft)}
.mod-card .mt{font-family:var(--font-display);font-weight:600;font-size:16px;color:var(--charcoal)}
.mod-card .md{font-size:12.5px;color:var(--muted);margin-top:6px;line-height:1.45}
.so-preview{background:var(--charcoal);color:var(--on-dark);border-radius:12px;padding:16px 18px}

/* ===== 12.2 · direção ===== */
.dash-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;align-items:start}
.dash-card{background:var(--white);border:1px solid var(--line-light);border-radius:var(--r-card);padding:18px 20px}
.dash-card .h{font-size:11.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
.dash-num{font-family:var(--font-display);font-weight:600;font-size:26px;color:var(--charcoal)}
.dash-stat{display:flex;align-items:baseline;gap:10px}
.dim-bar{display:flex;align-items:center;gap:12px;font-size:13.5px;padding:5px 0}
.dim-bar .label{min-width:118px;color:var(--charcoal)}
.dim-bar .bar{flex:1}
.trend{font-size:12px;font-weight:600;color:var(--muted);min-width:64px;text-align:right}
.list-row{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid var(--line-light);font-size:13.5px}
.list-row:last-child{border-bottom:none}
.locked-tag{font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--slate);background:var(--slate-soft);border-radius:5px;padding:2px 8px}
/* role switcher */
.sidebar{position:relative}
.sb-foot{margin-top:auto;cursor:pointer;width:auto;text-align:left}
.sb-foot:hover{background:rgba(255,255,255,.04)}
.role-menu{position:absolute;left:14px;right:14px;bottom:84px;background:var(--off-white);border:1px solid var(--line-light);border-radius:12px;box-shadow:var(--shadow-modal);padding:6px;display:none;flex-direction:column;gap:2px;z-index:40}
.role-menu.open{display:flex}
.role-item{display:flex;align-items:center;gap:11px;padding:9px 10px;border-radius:9px;text-align:left}
.role-item:hover{background:rgba(0,0,0,.04)}
.role-item.on{background:var(--olive-soft)}
.role-item .nm{font-size:13.5px;font-weight:600}
.role-item .rl{font-size:11.5px}

/* ===== 13.2 · professor + responsivo ===== */
.prof{max-width:520px;margin:0 auto;padding:20px 18px 90px}
.prof-top{display:flex;align-items:center;justify-content:space-between;padding:6px 0 18px}
.prof-top .wm{font-family:var(--font-display);font-size:20px;color:var(--charcoal)}
.prof-top .wm .dot{color:var(--terracotta)}
.prof-req{background:var(--white);border:1px solid var(--line-light);border-radius:var(--r-card);padding:18px 20px;margin-bottom:22px}
.doc{display:flex;align-items:center;gap:12px;background:var(--white);border:1px solid var(--line-light);border-radius:11px;padding:14px 16px;margin-bottom:10px}
.doc svg{width:20px;height:20px;color:var(--olive);flex:none}
.doc .dt{font-size:14px;font-weight:600;color:var(--charcoal)}
.doc .ds{font-size:12px;color:var(--muted)}
.menu-btn{display:none;width:36px;height:36px;border-radius:9px;align-items:center;justify-content:center;color:var(--charcoal);flex:none}
.menu-btn:hover{background:rgba(0,0,0,.04)}
.fab{display:none;position:fixed;right:18px;bottom:18px;width:56px;height:56px;border-radius:50%;background:var(--terracotta);color:#fff;align-items:center;justify-content:center;box-shadow:var(--shadow-soft);z-index:35}
.fab:hover{background:var(--terracotta-ink)}
.fab svg{width:24px;height:24px}
.scrim{display:none;position:fixed;inset:0;background:rgba(28,28,30,.3);z-index:39}
.scrim.open{display:block}

@media (max-width:1023px){
  .sidebar{width:64px;padding:18px 0}
  .sb-brand-sub,.sb-item>span:not(.badge),.sb-foot .nm,.sb-foot .rl{display:none}
  .sb-item{justify-content:center;padding:11px 0}
  .sb-foot{justify-content:center}
  .sb-brand{font-size:0}
  .sb-brand .dot{font-size:23px}
  .tb-search{width:150px}
  .prep-grid,.syn-grid,.vc-grid,.dash-grid,.rede{grid-template-columns:1fr}
  .dims,.fontes,.mod-grid{grid-template-columns:1fr 1fr}
  .role-menu{left:8px;right:auto;width:230px}
}
@media (max-width:639px){
  .sidebar{position:fixed;left:0;top:0;bottom:0;width:230px;transform:translateX(-100%);transition:transform .2s;z-index:40;padding:22px 0}
  .sidebar.open{transform:none}
  .sb-brand{font-size:23px}
  .sb-brand-sub,.sb-item>span,.sb-foot .nm,.sb-foot .rl{display:block}
  .sb-item{justify-content:flex-start;padding:11px 14px}
  .sb-foot{justify-content:flex-start}
  .menu-btn{display:flex}
  .tb-search{display:none}
  .topbar .gravar{display:none}
  .content{padding:16px 16px 90px}
  .dims,.fontes,.mod-grid,.cats{grid-template-columns:1fr}
  .fab{display:flex}
  .destino,.dim-bar{flex-wrap:wrap}
}

/* ===== correções de alinhamento (rodada desktop) ===== */
.ctx-box .ctx-gravar{ width:100%; justify-content:center; }
.ctx-box .ctx-row{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; margin-top:10px; }
.ctx-box .ctx-row .btn{ width:100%; justify-content:center; }
.ctx-box .ctx-solicitar{ width:100%; justify-content:center; margin-top:14px; }
.ctx-box hr{ border:none; border-top:1px solid var(--line-light); margin:14px 0; }
.rede,.dash-grid,.vc-grid,.dims,.fontes,.mod-grid{align-items:stretch}
.rede-col,.dash-card,.vc-col,.dim,.fonte,.mod-card{height:100%}
.cmb-btns,.cats,.add-ctx,.rubric-chips,.chips-filter,.dev-resp,.live-controls{flex-wrap:wrap}
.cmb-table td,.proto-meta .v,.dim-bar .trend,.list-row,.rec-time,.log-item .when,.tr-line .ts{font-variant-numeric:tabular-nums}
